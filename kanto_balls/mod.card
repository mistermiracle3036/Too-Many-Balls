return {
  summary = "Seven balls for Kanto: Premier (free with bulk ball purchases), Nest, Moon, Heal, Fast, Mirror, and the Silph prototype -- a Master Ball that works three times out of four.",
  author = "Mister Miracle",
  tags = { "balls", "items", "template" },
  differences = {
    "PREMIER BALL: not sold; buy 10+ balls in one purchase and the clerk throws in one free per 10 (buy 20, get 2), announced in the shop text. Plain 1x catch odds.",
    "NEST BALL (1000): better against low-level targets -- 4x at Lv15 or under, 3x at 25, 2x at 35, 1x above. Sold at the Great/Ultra marts.",
    "MOON BALL (1200): 4x against species that evolve by Moon Stone. Sold at Pewter Mart, before Mt. Moon.",
    "HEAL BALL (300): normal odds; the caught Pokemon arrives fully healed (HP, status, PP). Sold at the Great/Ultra marts.",
    "FAST BALL (1000): 4x against species with base Speed 100 or higher. Sold at the Great/Ultra marts.",
    "MIRROR BALL (1200): 4x when the wild Pokemon is the same species as the one you have out. Sold at the Great/Ultra marts.",
    "SILPH BALL (9800): Silph Co's abandoned Master Ball prototype -- a guaranteed catch, except one throw in four fizzles and the ball is spent anyway. Currently sold at Saffron Mart; intended to become a one-off quest reward.",
    "Renamed from Example Balls (mod id example_balls) at 0.2.0.",
  },
  credits = { "Mart-shelf mechanism follows Custom Poke Balls by magalvao (github.com/magalvao/custom-pokeballs)." },
  compat = {
    "Requires: shop_events (the Premier bonus listens to its shop.purchased event).",
    "Optional: pokeball_colors -- this mod owns its ball records AND their colors, and registers them on game.ready. Pokeball Colors must not carry entries for these ids.",
    "Optional: coexists with Custom Poke Balls; both append to the same mart shelves.",
    "Publishes exports.owns = { kanto_balls = true, balls = { ...ids... } } and exports.balls.",
  },
}
