return {
  summary = "Custom balls for Red/Blue/Yellow AND Gold: Premier (free with bulk ball purchases), Nest, Heal, Mirror and the prototype ball everywhere, plus Moon and Fast on Gen 1 (Gold has its own natives). The prototype is a Master Ball that fizzles one throw in two.",
  author = "Mister Miracle",
  tags = { "balls", "items", "template", "gold" },
  differences = {
    "PREMIER BALL: not sold; buy 10+ balls in one purchase and the clerk throws in one free per 10 (buy 20, get 2). Announced in the shop text on Gen 1; arrives silently in the BALLS pocket on Gold. Plain 1x catch odds.",
    "NEST BALL (1000): better against low-level targets -- 4x at Lv15 or under, 3x at 25, 2x at 35, 1x above. Sold at the Great/Ultra marts.",
    "MOON BALL (1200): Gen 1 only -- 4x against species that evolve by Moon Stone. Sold at Pewter Mart, before Mt. Moon. Gold has its own native Moon Ball.",
    "HEAL BALL (300): normal odds; the caught Pokemon arrives fully healed (HP, status, PP). Sold at the Great/Ultra marts.",
    "FAST BALL (1000): Gen 1 only -- 4x against species with base Speed 100 or higher. Sold at the Great/Ultra marts. Gold has its own native Fast Ball.",
    "MIRROR BALL (1200): 4x when the wild Pokemon is the same species as the one you have out. Sold at the Great/Ultra marts.",
    "SILPH BALL (9800): an abandoned Master Ball prototype -- a guaranteed catch, except one throw in TWO fizzles and the ball is spent anyway. Sold at Saffron Mart on Gen 1 and at Ultra-tier marts on Gold, where it is labelled PROTO BALL; intended to become a one-off quest reward.",
    "Every catch is marked with mon.caughtBall (as a fallback where pokeball_colors owns the field).",
    "Renamed from Example Balls (mod id example_balls) at 0.2.0.",
  },
  credits = { "Mart-shelf mechanism follows Custom Poke Balls by magalvao (github.com/magalvao/custom-pokeballs)." },
  compat = {
    "Requires: shop_events (the Premier bonus listens to its shop.purchased event).",
    "Runs on Gen 1 (Red/Blue/Yellow) and Gen 2 (Gold) since 0.4.0.",
    "Optional: pokeball_colors (Gen 1) -- this mod owns its ball records AND their colors, and registers them on game.ready. Pokeball Colors must not carry entries for these ids.",
    "Optional: coexists with Custom Poke Balls; both append to the same mart shelves.",
    "Publishes exports.owns = { kanto_balls = true, balls = { ...ids... } } and exports.balls.",
  },
}
